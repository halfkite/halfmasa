{
  "schemaVersion": 1,
  "id": "halfmasa",
  "version": "${mod_version}",
  "name": "halfmasa",
  "description": "halfmasa: a client-side Fabric utility mod for Xaero save binding, waypoints, creative tools, inventory screens, and JEI/REI lookup history.",
  "authors": ["half_masa"],
  "license": "MIT",
  "icon": "assets/halfmasa/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": ["io.github.halfmasa.xaerobinding.XaeroWorldBinding"],
    "modmenu": ["io.github.halfmasa.xaerobinding.compat.ModMenuIntegration"]
  },
  "mixins": ["halfmasa.mixins.json"],
  "depends": {
    "minecraft": "${minecraft_dependency}",
    "fabricloader": ">=0.16.14",
    "malilib": "${malilib_dependency}"
  },
  "suggests": {
    "xaerominimap": ">=26.4.0",
    "xaeroworldmap": ">=1.44.0",
    "modmenu": "*",
    "carpet": "*",
    "tweakeroo": "*",
    "roughlyenoughitems": "*",
    "jei": "*"
  }
}
